{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["jest", "node"]
  },
  "include": [
    "common/**/*.ts",
    "server/es/**/*.ts",
    "server/audit/**/*.ts",
    "server/repositories/**/*.ts",
    "server/actions/**/*.ts",
    "server/errors.ts"
  ]
}
