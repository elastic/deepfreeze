{
  "type": "plugin",
  "id": "@kbn/deepfreeze-plugin",
  "owner": [
    "@elastic/deepfreeze"
  ],
  "group": "platform",
  "visibility": "private",
  "description": "Manage Elasticsearch snapshot lifecycle to S3 Glacier / Azure Archive / GCS Coldline cold storage.",
  "plugin": {
    "id": "deepfreeze",
    "browser": true,
    "server": true,
    "configPath": [
      "xpack",
      "deepfreeze"
    ],
    "requiredPlugins": [
      "features",
      "management",
      "taskManager"
    ],
    "optionalPlugins": [
      "security",
      "usageCollection",
      "cloud",
      "home"
    ],
    "requiredBundles": [
      "kibanaReact"
    ]
  }
}
